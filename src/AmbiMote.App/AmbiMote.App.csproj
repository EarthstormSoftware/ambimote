<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AmbiMote.Core\AmbiMote.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AmbiMote</AssemblyName>
    <RootNamespace>AmbiMote.App</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ambimote.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>

    <!-- A plain AmbiMote.exe that carries the Windows App SDK with it: no MSIX, no runtime to install, and the
         start-with-Windows Run key can start it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Builds the resource index (AmbiMote.pri) and compiled XAML for dotnet publish too, not only for build. -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Program.cs has its own Main, to allow only one copy to run. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- The tray icon calls the Shell API with fixed-size buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drawn by tools/make-icon.cs. -->
    <Content Include="Assets\ambimote.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ambimote-off.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
